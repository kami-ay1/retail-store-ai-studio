{
  "name": "moyou-merchant-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "start": "tsx server/index.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test tests/server/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "build:web": "vite build"
  },
  "dependencies": {
    "@coze/api": "1.3.9",
    "@huggingface/transformers": "3.8.1",
    "@qdrant/js-client-rest": "1.20.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "express": "5.3.0",
    "lucide-vue-next": "^0.577.0",
    "multer": "2.4.0",
    "pinia": "3.0.4",
    "sharp": "0.35.5",
    "vue": "3.5.44",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "6.0.10",
    "concurrently": "^9.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
